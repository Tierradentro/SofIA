# ============================================================
# SofIA — variables de entorno para despliegue (EasyPanel)
# Copie estos valores en la sección "Environment" del servicio
# docker-compose en EasyPanel y reemplace los secretos.
# ============================================================

# OBLIGATORIOS (el backend no arranca sin ellos en producción):
JWT_SECRET=genere-una-cadena-aleatoria-larga-y-segura
OCR_ENCRYPTION_KEY=genere-otra-cadena-aleatoria-distinta

# URL pública del API tal como la verá el navegador.
# EasyPanel asigna un dominio al servicio nginx (puerto 8080);
# use ese dominio, p. ej.:
# NEXT_PUBLIC_API_URL=https://sofia.su-dominio.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
