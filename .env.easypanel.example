# ============================================================
# SofIA — variables de entorno para despliegue (EasyPanel)
# Copie estos valores en la sección "Environment" del servicio
# docker-compose en EasyPanel y reemplace los secretos.
# ============================================================

# OBLIGATORIOS (el despliegue no arranca sin ellos):

# Contraseña de PostgreSQL. AJ-007: ya no está en el repositorio.
# IMPORTANTE: si la base de datos YA existe (volumen pgdata), esta
# variable NO cambia la contraseña — debe ser la contraseña actual
# de la BD (en la instalación inicial fue "sofia_secret").
POSTGRES_PASSWORD=la-contrasena-actual-de-su-base-de-datos

# Secretos del backend (cadenas aleatorias largas y distintas):
JWT_SECRET=genere-una-cadena-aleatoria-larga-y-segura
OCR_ENCRYPTION_KEY=genere-otra-cadena-aleatoria-distinta

# OPCIONALES (tienen valor por defecto, normalmente no se definen):

# POSTGRES_USER=sofia_app
# POSTGRES_DB=sofia

# AJ-002: NO definir en producción. El valor por defecto es la ruta
# relativa /api/v1, que el navegador resuelve contra el dominio HTTPS
# público y nginx enruta al backend por la red interna. Si EasyPanel
# tiene esta variable definida de antes (p. ej. localhost:8080),
# elimínela o déjela vacía y RECONSTRUYA el frontend (NEXT_PUBLIC_*
# se incrusta en el bundle durante el build).
# NEXT_PUBLIC_API_URL=/api/v1
