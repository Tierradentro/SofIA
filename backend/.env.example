# SofIA Backend - variables de entorno
NODE_ENV=development
PORT=3001

# Base de datos PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=sofia_app
DB_PASSWORD=sofia_secret
DB_NAME=sofia

# JWT
JWT_SECRET=cambiar-en-produccion
JWT_EXPIRES_IN=8h

# I13 (obligatoria en producción): cifra las API keys de proveedores OCR
OCR_ENCRYPTION_KEY=cambiar-en-produccion

# Redis (blacklist de tokens / cache)
REDIS_URL=redis://redis:6379

# Archivos y exportaciones (volumen Docker)
FILES_DIR=/data/files
EXPORTS_DIR=/data/exports

# I31: migraciones y semillas corren SIEMPRE al arrancar (idempotentes).
# No hay variables RUN_MIGRATIONS/SEED_ON_BOOT: una configuración que las
# desactivaba dejaba el esquema desactualizado y rompía todo el API.
